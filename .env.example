# =====================================================================
# RuralConnect Environment Configuration
# =====================================================================

# --- Server & Network ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ruralconnect.vercel.app

# --- Database (MongoDB / MongoDB Atlas) ---
# For local development:
MONGODB_URI=mongodb://localhost:27017
# For production deployment with MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=ruralconnect

# --- Authentication & JWT Security ---
# Generate a strong 256-bit random key for production
JWT_SECRET=ruralconnect_super_secret_jwt_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Admin Account Bootstrap & Recovery ---
# Initial administrator credentials on first boot
ADMIN_INITIAL_EMAIL=admin@ruralconnect.in
ADMIN_INITIAL_PASSWORD=Admin@12345
# Secret bootstrap token for controlled remote/server-side admin recovery
ADMIN_BOOTSTRAP_KEY=ruralconnect_admin_bootstrap_secret_key_2026

# --- AI & Vector Retrieval (Google Gemini + Atlas Vector Search) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Name of the Atlas Vector Search index configured on knowledge_base collection
MONGODB_VECTOR_INDEX=vector_index

# --- OTP Security & Rate Limiting ---
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
RATE_LIMIT_OTP_PER_10_MIN=5

# --- Email Provider Configuration (options: mock | smtp | sendgrid) ---
EMAIL_PROVIDER=mock
# If using SMTP (Gmail, Zoho, Sendinblue, AWS SES):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@ruralconnect.in
# If using SendGrid:
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# --- SMS & Phone OTP Provider (options: mock | twilio | msg91 | fast2sms) ---
SMS_PROVIDER=mock
# If using Twilio:
TWILIO_ACCOUNT_SID=AC_your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
# If using MSG91 (India):
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=RURLCN
# If using Fast2SMS (India):
FAST2SMS_API_KEY=your_fast2sms_api_key

# --- Frontend Deployment URL ---
VITE_API_URL=http://localhost:8000
